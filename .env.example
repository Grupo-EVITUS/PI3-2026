# SAA — MongoDB 7 em replica set (exigido pelas transações da chamada e da fila).
# A aplicação não carrega este arquivo .env; configure as variáveis no ambiente do PHP.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=saa
MONGODB_TIMEOUT_MS=5000

# Notificação push (PWA/Web Push) — gere com: php bin/generate_vapid_keys.php
# A chave privada é segredo: configure no ambiente de hospedagem, nunca neste arquivo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:secretaria@escola.example.org
# Validade da mensagem no serviço de push, em segundos (padrão 86400).
PUSH_TTL_SECONDS=86400
