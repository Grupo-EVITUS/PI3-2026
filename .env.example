# SAA — MongoDB 7 replica set (fundação da etapa 2 e testes transacionais)
# O runtime atual ainda não carrega este arquivo .env; configure as variáveis no ambiente do PHP.
# Este bloco não ativa conexão do runtime da aplicação nem altera o armazenamento SQLite.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=saa
MONGODB_TIMEOUT_MS=5000
