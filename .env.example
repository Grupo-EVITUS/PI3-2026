# SAA — Sistema de Ausência de Alunos
# Copie este arquivo para ".env" e ajuste. O ".env" NUNCA deve ser versionado (RNF-14).
# Variáveis definidas no ambiente do sistema/Docker têm prioridade sobre o ".env".

# ---------------------------------------------------------------- Aplicação
# development | test | production
APP_ENV=development
# URL pública base. Usada nos links enviados por e-mail (justificativa e redefinição de senha).
# Em produção defina SEMPRE (ex.: https://saa.escola.com.br): o host da requisição pode ser forjado.
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Sao_Paulo
# true quando servido por HTTPS (cookie de sessão somente por conexão segura)
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# ---------------------------------------------------------------- MongoDB
# Local:        mongodb://127.0.0.1:27017
# Docker:       mongodb://mongo:27017
# Atlas (SRV):  mongodb+srv://usuario:senha@cluster.exemplo.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=saa
MONGODB_TIMEOUT_MS=5000

# ---------------------------------------------------------------- E-mail
# log  = apenas registra o e-mail no log de erros do PHP (desenvolvimento)
# file = grava um arquivo .eml por mensagem em var/mail/
# smtp = envia de verdade pelo servidor SMTP abaixo
MAIL_MODE=log
# Pasta dos arquivos .eml quando MAIL_MODE=file
MAIL_FILE_DIR=var/mail
MAIL_FROM=nao-responda@escola.local
MAIL_FROM_NAME="SAA - Sistema de Ausência de Alunos"
# Assinatura dos e-mails aos responsáveis
APP_SCHOOL_NAME="Equipe escolar"
# inline = envia logo após o registro da ausência | queue = só enfileira (use bin/process_mail_queue.php)
MAIL_DISPATCH=inline
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_ENCRYPTION=starttls
# Tempo máximo (segundos) de cada operação com o servidor SMTP
SMTP_TIMEOUT=15

# ---------------------------------------------------------------- Segurança
# Segredo exigido no cabeçalho X-Email-Webhook-Secret de POST /api/webhooks/email (RNF-04).
# Sem valor definido o webhook responde 503. Gere com: php -r "echo bin2hex(random_bytes(32));"
EMAIL_WEBHOOK_SECRET=
JUSTIFICATION_LINK_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---------------------------------------------------------------- Dados de demonstração (bin/seed.php)
# Senha dos usuários fictícios criados pelo seed. Se vazia, o seed gera senhas aleatórias e as exibe uma vez.
# O seed se recusa a rodar com APP_ENV=production.
SEED_PASSWORD=
