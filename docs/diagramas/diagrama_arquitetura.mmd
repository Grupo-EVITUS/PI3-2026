classDiagram
    direction TB

    class App {
        +boot() App
        +run() void
        +handle(Request) Response
    }
    class Router {
        +get(path, handler, options)
        +post(path, handler, options)
        +group(options, callback)
        +resolve(method, path) array
        +has(path) bool
    }
    class Route {
        +string method
        +string path
        +string access
        +string permission
        +bool csrf
    }
    class Request {
        +string(key) string
        +int(key) int
        +param(name) string
        +user() array
    }
    class Response {
        +html(body, status) Response
        +json(data, status) Response
        +redirect(to) Response
    }
    class View {
        +render(template, data, layout) string
        +partial(name, data) string
    }
    class Session {
        +start()
        +regenerate()
        +invalidate()
        +flash(kind, message)
        +expiredReason() string
    }
    class Csrf {
        +token() string
        +verify(Request)
    }
    class Container {
        +get(id)
        +singleton(id, factory)
    }
    class Validator {
        +make(data) Validator
        +required(field)
        +email(field)
        +passes() bool
        +errors() array
    }
    class SecurityHeaders {
        +apply(Response, Request) Response
    }
    class Permissions {
        +can(profile, permission) bool
        +grants() array
    }

    class Controller {
        <<abstract>>
        #render(template, data) Response
        #redirect(path) Response
    }
    class AuthController {
        +showLogin(Request) Response
        +login(Request) Response
        +logout(Request) Response
        +forgotPassword(Request) Response
    }
    class HomeController {
        +root(Request) Response
        +index(Request) Response
    }
    class ProfileController {
        +me(Request) Response
        +matrix(Request) Response
    }
    class HealthController {
        +show(Request) Response
    }

    class AuthService {
        +attempt(email, password, ip) array
        +logout()
        +currentUser() array
        +createUser(data) string
    }
    class AuditService {
        +record(action, entityType, entityId, details)
    }
    class SystemStatusService {
        +health() array
        +environment() array
    }

    class Model {
        <<abstract>>
        #Collection collection
    }
    class UserModel {
        +create(data) ObjectId
        +findByEmail(email) array
        +findActiveById(id) array
        +touchLogin(id)
    }
    class LoginAttemptModel {
        +record(key)
        +countSince(key, since) int
    }
    class AuditEventModel {
        +insert(event)
        +latest(limit) array
    }
    class SystemModel {
        +ping() bool
        +serverVersion() string
    }

    class Mongo {
        +database() Database
        +collection(name) Collection
        +ping() bool
    }
    class Schema {
        +initialize(Database)
        +definitions() array
    }

    App --> Router
    App --> Container
    App --> Session
    App --> SecurityHeaders
    App ..> Permissions : controle de acesso por rota
    Router "1" *-- "*" Route
    App ..> Request
    App ..> Response
    Controller <|-- AuthController
    Controller <|-- HomeController
    Controller <|-- ProfileController
    Controller <|-- HealthController
    Controller ..> View
    AuthController --> AuthService
    HomeController --> SystemStatusService
    HealthController --> SystemStatusService
    AuthService --> UserModel
    AuthService --> LoginAttemptModel
    AuthService --> AuditService
    AuthService --> Session
    AuthService --> Csrf
    AuditService --> AuditEventModel
    SystemStatusService --> SystemModel
    Model <|-- UserModel
    Model <|-- LoginAttemptModel
    Model <|-- AuditEventModel
    Model <|-- SystemModel
    Model ..> Mongo : Database injetado
    Schema ..> Mongo
